+/* BTCK-DEVADDR: on the OUTGOING offer only, adds the DEVADDR session
+ * attribute (routes sip:diy@ to the door station camera) and offers the
+ * video as sendrecv. Inert when BTCK_DEVADDR is unset -> safe binary. */
+static void btck_on_call_sdp_created(pjsua_call_id call_id,
+                                     pjmedia_sdp_session *sdp,
+                                     pj_pool_t *pool,
+                                     const pjmedia_sdp_session *rem_sdp)
+{
+    const char *dev = getenv("BTCK_DEVADDR");
+    pjmedia_sdp_attr *a;
+    pj_str_t val;
+    unsigned i;
+    if (rem_sdp || !dev || !*dev)
+        return;
+    if (call_id >= 0 && call_id < (pjsua_call_id)PJSUA_MAX_CALLS
+        && btck_uas[call_id])
+        return;
+    pj_strdup2(pool, &val, dev);
+    a = pjmedia_sdp_attr_create(pool, "DEVADDR", &val);
+    if (pjmedia_sdp_attr_add(&sdp->attr_count, sdp->attr, a) != PJ_SUCCESS) {
+        PJ_LOG(2,(THIS_FILE, "BTCK-DEVADDR attr_add failed"));
+        return;
+    }
+    for (i = 0; i < sdp->media_count; ++i) {
+        pjmedia_sdp_media *m = sdp->media[i];
+        if (pj_stricmp2(&m->desc.media, "video") != 0)
+            continue;
+        pjmedia_sdp_media_remove_all_attr(m, "sendrecv");
+        pjmedia_sdp_media_remove_all_attr(m, "sendonly");
+        pjmedia_sdp_media_remove_all_attr(m, "inactive");
+        pjmedia_sdp_media_remove_all_attr(m, "recvonly");
+        m->attr[m->attr_count++] =
+            pjmedia_sdp_attr_create(pool, "sendrecv", NULL);
+    }
+    PJ_LOG(3,(THIS_FILE, "BTCK-DEVADDR injected (video sendrecv)"));
+}
 /* Callback to replace the generated SDP with a custom one (--custom-sdp).
