+            PJ_LOG(3, (THIS_FILE, "BTCK-AVI-DONE %s", btck_done));
+            btck_avi_rotate();
+        }
+#endif
         PJ_LOG(3,(THIS_FILE, "Call %d is DISCONNECTED [reason=%d (%.*s)]", 
                   call_id,
                   call_info.last_status,
@@ -370,6 +447,8 @@ static void on_incoming_call(pjsua_acc_id acc_id, pjsua_call_id call_id,
