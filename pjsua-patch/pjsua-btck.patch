 #define THIS_FILE       "pjsua_app.c"
 
+/* BTCK: one AVI file per call (one recorder per ring). Everything is static so that
+ * struct app_config is untouched (frozen header -> only 2 .c files recompile). */
+static pjsua_call_id btck_avi_owner = PJSUA_INVALID_ID; /* call that owns the stream */
+static unsigned      btck_avi_seq   = 0;                /* same-second anti-collision */
+static char          btck_avi_name[PJ_MAXPATH];         /* current file name */
+static pj_bool_t     btck_uas[PJSUA_MAX_CALLS];          /* BTCK-DEVADDR: incoming call -> no DEVADDR injection */
+
+#if PJMEDIA_HAS_VIDEO
+static void avi_writer_cb(pjsua_avi_rec_id id, void *user_data); /* defined below */
+/* (Re)creates the AVI recorder under a fresh timestamped name. Returns PJ_SUCCESS, or
+ * leaves avi_rec_id INVALID on failure (non-fatal). Called at startup and every time
+ * the owning call hangs up. */
+static pj_status_t btck_avi_rotate(void)
+{
+    pj_time_val tv;
+    pj_str_t fname;
+    pj_status_t status;
+    int n, blen;
+    const char *base = app_config.avi_rec.ptr;
+    blen = (int)app_config.avi_rec.slen;
+
+    /* strip the .avi suffix from the base name, if present */
+    if (blen >= 4 && pj_ansi_strnicmp(base + blen - 4, ".avi", 4) == 0)
+        blen -= 4;
+
+    pj_gettimeofday(&tv);
+    n = pj_ansi_snprintf(btck_avi_name, sizeof(btck_avi_name),
+                         "%.*s_%ld_%u.avi", blen, base,
+                         (long)tv.sec, btck_avi_seq++);
+    if (n <= 0 || n >= (int)sizeof(btck_avi_name)) {
+        PJ_LOG(2, (THIS_FILE, "BTCK-AVI name too long, skip rotate"));
+        app_config.avi_rec_id = PJSUA_INVALID_ID;
+        app_config.avi_vid_slot = PJSUA_INVALID_ID;
+        app_config.avi_aud_slot = PJSUA_INVALID_ID;
+        return PJ_ETOOBIG;
+    }
+
+    fname = pj_str(btck_avi_name);
+    status = pjsua_avi_recorder_create(&fname, app_config.avi_rec_size,
+                                       NULL, NULL, 0, &app_config.avi_rec_id);
+    if (status != PJ_SUCCESS) {
+        PJ_PERROR(2, (THIS_FILE, status, "BTCK-AVI create failed"));
+        app_config.avi_rec_id = PJSUA_INVALID_ID;
+        app_config.avi_vid_slot = PJSUA_INVALID_ID;
+        app_config.avi_aud_slot = PJSUA_INVALID_ID;
+        return status;
+    }
+    app_config.avi_vid_slot = pjsua_avi_recorder_get_conf_port(
+                                  app_config.avi_rec_id, PJMEDIA_TYPE_VIDEO);
+    app_config.avi_aud_slot = pjsua_avi_recorder_get_conf_port(
+                                  app_config.avi_rec_id, PJMEDIA_TYPE_AUDIO);
+    pjsua_avi_recorder_set_cb(app_config.avi_rec_id, NULL, &avi_writer_cb);
+    PJ_LOG(3, (THIS_FILE, "BTCK-AVI-START %s", btck_avi_name));
+    return PJ_SUCCESS;
+}
+#endif
